# Wi-Fi Router

# interface and driver
interface=wlan0
#driver=nl80211
driver=none

ctrl_interface=/var/run/hostapd
ctrl_interface_group=0

# WiFi configuration
ssid=wifi_WEP
channel=1
hw_mode=g
country_code=DE

# WiFi encryption
macaddr_acl=0
auth_algs=1
ignore_broadcast_ssid=0
wep_default_key=1
wep_key1=abcdeabcde
wep_key_len_broadcast=5
wep_key_len_unicast=5
wep_rekey_period=300